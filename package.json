{
  "name": "clippi",
  "productName": "Clippi",
  "version": "0.1.2",
  "description": "Turn Slippi replays into shareable Melee highlight clips.",
  "type": "module",
  "main": "shell/main.cjs",
  "scripts": {
    "start": "node serve.mjs",
    "shell": "electron shell/main.cjs",
    "package": "electron-packager . Clippi --platform=win32 --arch=x64 --out=dist --overwrite --app-copyright=\"Attune Games\" --ignore=\"^/dist\" --ignore=\"^/tools\" --ignore=\"^/\\.git\" --ignore=\"\\.log$\""
  },
  "author": "Attune Games",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@slippi/slippi-js": "^9.1.3",
    "koffi": "^3.2.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "@electron/packager": "^18.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/attunegames/clippi"
  }
}
